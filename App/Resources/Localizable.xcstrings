          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokira to vrsto datoteke. Potrebna je povezava Google Drive."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail bloquea este tipo de archivo. Se requiere un enlace Google Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail bloquea este tipo de archivo. Se requiere un enlace Google Drive."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blockerar denna filtyp. En länk Google Drive krävs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail இந்தக் கோப்பு வகையைத் தடுக்கிறது. இணைப்பு Google Drive தேவை."
