          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಕಳುಹಿಸುವ ಮೊದಲು ಪೂರ್ಣ ಪರಿಶೀಲನೆಯೊಂದಿಗೆ ಫೈಂಡರ್‌ನಿಂದ ಫೈಲ್‌ಗಳನ್ನು ಕಳುಹಿಸಿ."
          }
        },
        "ko": {
