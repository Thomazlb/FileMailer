          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిఫాల్ట్ స్థానికం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ท้องถิ่นเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan yerel"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальний за умовчанням"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے سے طے شدہ مقامی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa phương mặc định"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认本地"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設本地"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Local par défaut"
          }
        }
      }
    },
    "Analysis and Apple Intelligence generation stay on your Mac. The message and its attachments go to Google only when you press Send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى التحليل والإنشاء Apple Intelligence على جهاز Mac الخاص بك. تنتقل الرسالة ومرفقاتها إلى Google فقط عند الضغط على \"إرسال\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্লেষণ এবং প্রজন্ম Apple Intelligence আপনার Mac এ রয়ে গেছে। বার্তা এবং এর সংযুক্তিগুলি শুধুমাত্র Google এ যায় যখন আপনি পাঠান টিপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anàlisi i la generació Apple Intelligence roman al vostre Mac. El missatge i els seus fitxers adjunts només van a Google quan premeu Envia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza a generování Apple Intelligence zůstává na vašem Macu. Zpráva a její přílohy se přesunou na Google pouze po stisknutí Odeslat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse og generering Apple Intelligence forbliver på din Mac. Beskeden og dens vedhæftede filer går kun til Google, når du trykker på Send."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse und Generierung Apple Intelligence bleibt auf Ihrem Mac. Die Nachricht und ihre Anhänge werden erst an Google gesendet, wenn Sie auf „Senden“ klicken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάλυση και η παραγωγή Apple Intelligence παραμένουν στο Mac σας. Το μήνυμα και τα συνημμένα του πηγαίνουν στο Google μόνο όταν πατάτε Αποστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis and Apple Intelligence generation stay on your Mac. The message and its attachments go to Google only when you press Send."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis and Apple Intelligence generation stay on your Mac. The message and its attachments go to Google only when you press Send."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis and Apple Intelligence generation stay on your Mac. The message and its attachments go to Google only when you press Send."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis and Apple Intelligence generation stay on your Mac. The message and its attachments go to Google only when you press Send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis y la generación Apple Intelligence permanecen en tu Mac. El mensaje y sus archivos adjuntos solo van a Google cuando presiona Enviar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis y la generación Apple Intelligence permanecen en tu Mac. El mensaje y sus archivos adjuntos solo van a Google cuando presiona Enviar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyysi ja sukupolvi Apple Intelligence pysyvät Macissasi. Viesti ja sen liitteet siirtyvät kohtaan Google vain, kun painat Lähetä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse et la génération Apple Intelligence restent sur votre Mac. Le message et ses pièces jointes vont uniquement chez Google au moment où vous appuyez sur Envoyer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિશ્લેષણ અને જનરેશન Apple Intelligence તમારા Mac પર રહે છે. જ્યારે તમે મોકલો દબાવો ત્યારે જ સંદેશ અને તેના જોડાણો Google પર જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוח ויצירת Apple Intelligence נשארים ב-Mac שלך. ההודעה והקבצים המצורפים שלה עוברים אל Google רק כאשר אתה לוחץ על שלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण और जनरेशन Apple Intelligence आपके Mac पर बना रहता है। जब आप भेजें दबाते हैं तो संदेश और उसके अनुलग्नक केवल Google पर जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza i generiranje Apple Intelligence ostaje na vašem Macu. Poruka i njezini privici idu na Google samo kada pritisnete Pošalji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemzés és a Apple Intelligence generálás a Mac-en marad. Az üzenet és mellékletei csak a Google mappába kerülnek, ha megnyomja a Küldés gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis dan pembuatan Apple Intelligence tetap ada di Mac Anda. Pesan dan lampirannya hanya masuk ke Google bila Anda menekan Kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analisi e la generazione Apple Intelligence rimangono sul tuo Mac. Il messaggio e i suoi allegati vengono inviati a Google solo quando si preme Invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析と生成 Apple Intelligence は Mac に残ります。 [送信] を押した場合、メッセージとその添付ファイルは Google にのみ送信されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಶ್ಲೇಷಣೆ ಮತ್ತು ಉತ್ಪಾದನೆ Apple Intelligence ನಿಮ್ಮ Mac ನಲ್ಲಿ ಉಳಿದಿದೆ. ನೀವು ಕಳುಹಿಸು ಒತ್ತಿದಾಗ ಸಂದೇಶ ಮತ್ತು ಅದರ ಲಗತ್ತುಗಳು Google ಗೆ ಮಾತ್ರ ಹೋಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 및 생성 Apple Intelligence은 Mac에 남아 있습니다. 보내기를 누르면 메시지와 첨부 파일이 Google로만 이동됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിശകലനവും ജനറേഷനും Apple Intelligence നിങ്ങളുടെ Mac-ൽ ശേഷിക്കുന്നു. നിങ്ങൾ അയയ്ക്കുക അമർത്തുമ്പോൾ സന്ദേശവും അതിൻ്റെ അറ്റാച്ചുമെൻ്റുകളും Google എന്നതിലേക്ക് മാത്രമേ പോകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण आणि निर्मिती Apple Intelligence तुमच्या Mac वर राहते. जेव्हा तुम्ही पाठवा दाबता तेव्हाच संदेश आणि त्याचे संलग्नक Google वर जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis dan penjanaan Apple Intelligence kekal pada Mac anda. Mesej dan lampirannya hanya pergi ke Google apabila anda menekan Hantar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse en generatie Apple Intelligence blijft op uw Mac staan. Het bericht en de bijlagen gaan alleen naar Google als u op Verzenden drukt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse og generering Apple Intelligence forblir på Mac-en. Meldingen og dens vedlegg går bare til Google når du trykker Send."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିଶ୍ଳେଷଣ ଏବଂ ପି generation ଼ି Apple Intelligence ଆପଣଙ୍କ ମାକରେ ରହିଥାଏ | ମେସେଜ୍ ଏବଂ ଏହାର ସଂଲଗ୍ନଗୁଡିକ କେବଳ Google କୁ ଯାଏ ଯେତେବେଳେ ତୁମେ ପ୍ରେରଣ ଦବ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਸ਼ਲੇਸ਼ਣ ਅਤੇ ਉਤਪਾਦਨ Apple Intelligence ਤੁਹਾਡੇ ਮੈਕ 'ਤੇ ਰਹਿੰਦਾ ਹੈ। ਸੁਨੇਹਾ ਅਤੇ ਇਸਦੇ ਅਟੈਚਮੈਂਟ ਸਿਰਫ਼ Google 'ਤੇ ਜਾਂਦੇ ਹਨ ਜਦੋਂ ਤੁਸੀਂ ਭੇਜੋ ਨੂੰ ਦਬਾਉਂਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza i generowanie Apple Intelligence pozostaje na komputerze Mac. Wiadomość wraz z załącznikami trafia do Google dopiero po naciśnięciu przycisku Wyślij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise e geração Apple Intelligence permanecem no seu Mac. A mensagem e seus anexos só vão para Google quando você pressiona Enviar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise e geração Apple Intelligence permanecem no seu Mac. A mensagem e os seus anexos só vão para Google quando pressiona Enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza și generarea Apple Intelligence rămâne pe Mac. Mesajul și atașamentele sale ajung la Google numai când apăsați pe Trimitere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ и создание Apple Intelligence остается на вашем Mac. Сообщение и вложения к нему передаются на Google только после нажатия кнопки «Отправить»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza a generovanie Apple Intelligence zostáva na vašom Macu. Správa a jej prílohy prejdú na Google iba vtedy, keď stlačíte Odoslať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza in generiranje Apple Intelligence ostane na vašem Macu. Sporočilo in njegove priloge gredo na Google šele, ko pritisnete Pošlji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analys och generering Apple Intelligence finns kvar på din Mac. Meddelandet och dess bilagor går bara till Google när du trycker på Skicka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகுப்பாய்வு மற்றும் உருவாக்கம் Apple Intelligence உங்கள் Mac இல் உள்ளது. அனுப்பு என்பதை அழுத்தினால் செய்தியும் அதன் இணைப்புகளும் Google க்கு மட்டுமே செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Macలో విశ్లేషణ మరియు తరం Apple Intelligence మిగిలి ఉంది. మీరు పంపు నొక్కినప్పుడు సందేశం మరియు దాని జోడింపులు Googleకి మాత్రమే వెళ్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์และการสร้าง Apple Intelligence ยังคงอยู่ใน Mac ของคุณ ข้อความและไฟล์แนบจะไปที่ Google เมื่อคุณกดส่งเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz ve oluşturma Apple Intelligence Mac'inizde kalır. Mesaj ve ekleri yalnızca Gönder tuşuna bastığınızda Google konumuna gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз і генерація Apple Intelligence залишаються на вашому Mac. Повідомлення та його вкладення переходять лише до Google, коли ви натискаєте «Надіслати»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے میک پر تجزیہ اور نسل Apple Intelligence باقی ہے۔ پیغام اور اس کے منسلکات صرف Google پر جائیں گے جب آپ بھیجیں دبائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích và tạo Apple Intelligence vẫn còn trên máy Mac của bạn. Tin nhắn và tệp đính kèm chỉ chuyển đến Google khi bạn nhấn Gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析和生成 Apple Intelligence 保留在您的 Mac 上。当您按“发送”时，消息及其附件仅发送至 Google。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 分析和產生保留在您的 Mac 上。當您按下「傳送」時，訊息及其附件只會傳送至 Google。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse et la génération Apple Intelligence restent sur votre Mac. Le message et ses pièces jointes vont uniquement chez Google au moment où vous appuyez sur Envoyer."
          }
        }
      }
    },
