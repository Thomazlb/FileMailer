    "Send files from Finder with full verification before each send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الملفات من Finder مع التحقق الكامل قبل كل إرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি পাঠানোর আগে সম্পূর্ণ যাচাইকরণ সহ ফাইন্ডার থেকে ফাইলগুলি পাঠান।"
          }
        },
        "ca": {
