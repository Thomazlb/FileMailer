    "Projet open source sous licence MIT. Aucun analytics, tracking ou serveur intermédiaire.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشروع مفتوح المصدر بموجب ترخيص MIT. لا توجد تحليلات أو تتبع أو خادم وسيط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT লাইসেন্সের অধীনে ওপেন সোর্স প্রকল্প। কোনো বিশ্লেষণ, ট্র্যাকিং বা মধ্যবর্তী সার্ভার নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Projecte de codi obert sota llicència MIT. Sense anàlisi, seguiment o servidor intermedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT 许可下的开源项目。没有分析、跟踪或中间服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT 許可下的開源專案。沒有分析、追蹤或中間伺服器。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt otvorenog koda pod licencom MIT-a. Nema analitike, praćenja ili posredničkog poslužitelja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source projekt pod licencí MIT. Žádná analytika, sledování nebo zprostředkující server."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source-projekt under MIT-licens. Ingen analyser, sporing eller mellemserver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source-project onder MIT-licentie. Geen analyses, tracking of tussenserver."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source project under MIT license. No analytics, tracking or intermediate server."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source project under MIT license. No analytics, tracking or intermediate server."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source project under MIT license. No analytics, tracking or intermediate server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source project under MIT license. No analytics, tracking or intermediate server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoimen lähdekoodin projekti MIT-lisenssillä. Ei analytiikkaa, seurantaa tai välipalvelinta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Projet open source sous licence MIT. Aucun analytics, tracking ou serveur intermédiaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-Source-Projekt unter MIT-Lizenz. Keine Analyse, Nachverfolgung oder Zwischenserver."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έργο ανοιχτού κώδικα με άδεια MIT. Χωρίς αναλυτικά στοιχεία, παρακολούθηση ή ενδιάμεσο διακομιστή."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT લાયસન્સ હેઠળ ઓપન સોર્સ પ્રોજેક્ટ. કોઈ એનાલિટિક્સ, ટ્રેકિંગ અથવા મધ્યવર્તી સર્વર નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרויקט קוד פתוח תחת רישיון MIT. אין ניתוח, מעקב או שרת ביניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एमआईटी लाइसेंस के तहत ओपन सोर्स प्रोजेक्ट। कोई विश्लेषण, ट्रैकिंग या मध्यवर्ती सर्वर नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyílt forráskódú projekt MIT licenc alatt. Nincs elemzés, nyomkövető vagy köztes szerver."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek sumber terbuka di bawah lisensi MIT. Tidak ada analitik, pelacakan, atau server perantara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progetto open source su licenza MIT. Nessuna analisi, tracciamento o server intermedio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MITライセンスに基づくオープンソースプロジェクト。分析、追跡、中間サーバーはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT ಪರವಾನಗಿ ಅಡಿಯಲ್ಲಿ ಮುಕ್ತ ಮೂಲ ಯೋಜನೆ. ಯಾವುದೇ ವಿಶ್ಲೇಷಣೆ, ಟ್ರ್ಯಾಕಿಂಗ್ ಅಥವಾ ಮಧ್ಯಂತರ ಸರ್ವರ್ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT 라이선스에 따른 오픈 소스 프로젝트입니다. 분석, 추적 또는 중간 서버가 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Projek sumber terbuka di bawah lesen MIT. Tiada analitik, penjejakan atau pelayan perantaraan."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT ലൈസൻസിന് കീഴിലുള്ള ഓപ്പൺ സോഴ്സ് പ്രോജക്റ്റ്. അനലിറ്റിക്സ്, ട്രാക്കിംഗ് അല്ലെങ്കിൽ ഇൻ്റർമീഡിയറ്റ് സെർവർ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT परवान्याअंतर्गत मुक्त स्रोत प्रकल्प. कोणतेही विश्लेषण, ट्रॅकिंग किंवा इंटरमीडिएट सर्व्हर नाही."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpen kildekode-prosjekt under MIT-lisens. Ingen analyser, sporing eller mellomserver."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT ଲାଇସେନ୍ସ ଅନ୍ତର୍ଗତ ମୁକ୍ତ ଉତ୍ସ ପ୍ରକଳ୍ପ | କ No ଣସି ଆନାଲିଟିକ୍ସ, ଟ୍ରାକିଂ କିମ୍ବା ମଧ୍ୟବର୍ତ୍ତୀ ସର୍ଭର ନାହିଁ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt open source na licencji MIT. Brak analiz, śledzenia i serwera pośredniego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeto de código aberto sob licença MIT. Sem análise, rastreamento ou servidor intermediário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeto de código aberto sob licença MIT. Sem análise, rastreamento ou servidor intermediário."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT ਲਾਇਸੰਸ ਦੇ ਤਹਿਤ ਓਪਨ ਸੋਰਸ ਪ੍ਰੋਜੈਕਟ। ਕੋਈ ਵਿਸ਼ਲੇਸ਼ਣ, ਟਰੈਕਿੰਗ ਜਾਂ ਇੰਟਰਮੀਡੀਏਟ ਸਰਵਰ ਨਹੀਂ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Proiect open source sub licență MIT. Fără analize, urmărire sau server intermediar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект с открытым исходным кодом под лицензией MIT. Никакой аналитики, отслеживания или промежуточного сервера."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source projekt pod licenciou MIT. Žiadna analytika, sledovanie alebo sprostredkujúci server."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprtokodni projekt pod licenco MIT. Brez analitike, sledenja ali vmesnega strežnika."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyecto de código abierto bajo licencia MIT. Sin análisis, seguimiento ni servidor intermedio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyecto de código abierto bajo licencia MIT. Sin análisis, seguimiento ni servidor intermedio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source-projekt under MIT-licens. Ingen analys, spårning eller mellanliggande server."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT உரிமத்தின் கீழ் திறந்த மூல திட்டம். பகுப்பாய்வு, கண்காணிப்பு அல்லது இடைநிலை சேவையகம் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT లైసెన్స్ క్రింద ఓపెన్ సోర్స్ ప్రాజెక్ట్. విశ్లేషణలు, ట్రాకింగ్ లేదా ఇంటర్మీడియట్ సర్వర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงการโอเพ่นซอร์สภายใต้ใบอนุญาต MIT ไม่มีการวิเคราะห์ การติดตาม หรือเซิร์ฟเวอร์ระดับกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT lisansı altında açık kaynaklı proje. Analitik, izleme veya ara sunucu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект з відкритим кодом під ліцензією MIT. Без аналітики, відстеження чи проміжного сервера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT لائسنس کے تحت اوپن سورس پروجیکٹ۔ کوئی تجزیات، ٹریکنگ یا انٹرمیڈیٹ سرور نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự án nguồn mở theo giấy phép MIT. Không có phân tích, theo dõi hoặc máy chủ trung gian."
          }
        }
      }
    },
