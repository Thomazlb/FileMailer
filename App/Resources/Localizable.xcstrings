    "Envoyez des fichiers depuis le Finder avec une vérification complète avant chaque envoi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الملفات من Finder مع التحقق الكامل قبل كل إرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি পাঠানোর আগে সম্পূর্ণ যাচাইকরণ সহ ফাইন্ডার থেকে ফাইলগুলি পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envieu fitxers des del Finder amb una verificació completa abans de cada enviament."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Finder 发送文件，并在每次发送前进行全面验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Finder 發送文件，並在每次發送前進行全面驗證。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite datoteke iz Findera uz punu provjeru prije svakog slanja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílejte soubory z Finderu s úplným ověřením před každým odesláním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send filer fra Finder med fuld bekræftelse før hver afsendelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuur bestanden vanuit Finder met volledige verificatie vóór elke verzending."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Send files from Finder with full verification before each send."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Send files from Finder with full verification before each send."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Send files from Finder with full verification before each send."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send files from Finder with full verification before each send."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä tiedostoja Finderista täydellä vahvistuksella ennen jokaista lähetystä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez des fichiers depuis le Finder avec une vérification complète avant chaque envoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie Dateien aus dem Finder mit vollständiger Überprüfung vor jedem Versand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε αρχεία από το Finder με πλήρη επαλήθευση πριν από κάθε αποστολή."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક મોકલતા પહેલા સંપૂર્ણ ચકાસણી સાથે ફાઇન્ડરમાંથી ફાઇલો મોકલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח קבצים מ-Finder עם אימות מלא לפני כל שליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक भेजने से पहले पूर्ण सत्यापन के साथ फाइंडर से फ़ाइलें भेजें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fájlok küldése a Finderből minden küldés előtt teljes ellenőrzéssel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim file dari Finder dengan verifikasi penuh sebelum setiap pengiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia file dal Finder con verifica completa prima di ogni invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder からファイルを送信する際は、送信前に完全な検証を行ってください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಕಳುಹಿಸುವ ಮೊದಲು ಪೂರ್ಣ ಪರಿಶೀಲನೆಯೊಂದಿಗೆ ಫೈಂಡರ್‌ನಿಂದ ಫೈಲ್‌ಗಳನ್ನು ಕಳುಹಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전에 전체 확인을 통해 Finder에서 파일을 보냅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar fail daripada Finder dengan pengesahan penuh sebelum setiap penghantaran."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ അയയ്‌ക്കുന്നതിനും മുമ്പായി ഫൈൻഡറിൽ നിന്ന് പൂർണ്ണ പരിശോധനയോടെ ഫയലുകൾ അയയ്‌ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक पाठवण्यापूर्वी पूर्ण पडताळणीसह फाइंडरकडून फायली पाठवा."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Send filer fra Finder med full bekreftelse før hver sending."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ପଠାଇବା ପୂର୍ବରୁ ଫାଇଣ୍ଡରରୁ ସମ୍ପୂର୍ଣ୍ଣ ଯାଞ୍ଚ ସହିତ ଫାଇଲ ପଠାନ୍ତୁ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj pliki z Findera z pełną weryfikacją przed każdym wysłaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie arquivos do Finder com verificação completa antes de cada envio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie arquivos do Finder com verificação completa antes de cada envio."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰੇਕ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਪੂਰੀ ਤਸਦੀਕ ਨਾਲ ਫਾਈਂਡਰ ਤੋਂ ਫਾਈਲਾਂ ਭੇਜੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiteți fișiere din Finder cu verificare completă înainte de fiecare trimitere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте файлы из Finder с полной проверкой перед каждой отправкой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosielajte súbory z Findera s úplným overením pred každým odoslaním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošljite datoteke iz Finderja s popolnim preverjanjem pred vsakim pošiljanjem."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe archivos desde Finder con verificación completa antes de cada envío."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe archivos desde Finder con verificación completa antes de cada envío."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka filer från Finder med fullständig verifiering före varje sändning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு அனுப்பும் முன் முழு சரிபார்ப்புடன் ஃபைண்டரிலிருந்து கோப்புகளை அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి పంపడానికి ముందు ఫైండర్ నుండి పూర్తి ధృవీకరణతో ఫైల్‌లను పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไฟล์จาก Finder พร้อมการยืนยันแบบเต็มก่อนส่งแต่ละครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları her göndermeden önce tam doğrulamayla Finder'dan gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилайте файли з Finder із повною перевіркою перед кожним надсиланням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائنڈر سے فائلیں ہر بھیجنے سے پہلے مکمل تصدیق کے ساتھ بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi tệp từ Finder với xác minh đầy đủ trước mỗi lần gửi."
          }
        }
      }
