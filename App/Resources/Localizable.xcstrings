          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive इस फ़ाइल को लिंक द्वारा पहुंच योग्य बनाने की अनुमति नहीं देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
