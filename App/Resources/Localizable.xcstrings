          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ને મેન્યુઅલ સક્રિયકરણની જરૂર છે. FileMailer Finder માં કોઈપણ કોડ દાખલ કરતું નથી."
          }
        },
        "he": {
          "stringUnit": {
