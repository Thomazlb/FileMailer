        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive ಈ ಫೈಲ್ ಅನ್ನು ಲಿಂಕ್ ಮೂಲಕ ಪ್ರವೇಶಿಸಲು ಅನುಮತಿಸುವುದಿಲ್ಲ."
