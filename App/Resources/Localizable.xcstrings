    "Add at least one recipient before creating a Google Drive link.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez au moins un destinataire avant de créer un lien Google Drive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one recipient before creating a Google Drive link."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإضافة مستلم واحد على الأقل قبل إنشاء الرابط Google Drive."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি লিঙ্ক Google Drive তৈরি করার আগে কমপক্ষে একজন প্রাপক যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegiu almenys un destinatari abans de crear un enllaç Google Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建链接 Google Drive 之前至少添加一名收件人。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte barem jednog primatelja prije stvaranja veze Google Drive."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před vytvořením odkazu přidejte alespoň jednoho příjemce Google Drive."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj mindst én modtager, før du opretter et link Google Drive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg ten minste één ontvanger toe voordat u een link maakt Google Drive."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää vähintään yksi vastaanottaja ennen linkin luomista Google Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie mindestens einen Empfänger hinzu, bevor Sie einen Link erstellen Google Drive."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε τουλάχιστον έναν παραλήπτη πριν δημιουργήσετε έναν σύνδεσμο Google Drive."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લિંક Google Drive બનાવતા પહેલા ઓછામાં ઓછા એક પ્રાપ્તકર્તાને ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף נמען אחד לפחות לפני יצירת קישור Google Drive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक बनाने से पहले कम से कम एक प्राप्तकर्ता जोड़ें Google Drive।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hivatkozás létrehozása előtt adjon hozzá legalább egy címzettet Google Drive."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan setidaknya satu penerima sebelum membuat tautan Google Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi almeno un destinatario prima di creare un collegamento Google Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを作成する前に、少なくとも 1 人の受信者を追加してください Google Drive。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲಿಂಕ್ Google Drive ರಚಿಸುವ ಮೊದಲು ಕನಿಷ್ಠ ಒಬ್ಬ ಸ್ವೀಕೃತದಾರರನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 Google Drive를 만들기 전에 수신자를 한 명 이상 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan sekurang-kurangnya seorang penerima sebelum membuat pautan Google Drive."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ലിങ്ക് Google Drive സൃഷ്‌ടിക്കുന്നതിന് മുമ്പ് ഒരു സ്വീകർത്താവിനെയെങ്കിലും ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक Google Drive तयार करण्यापूर्वी किमान एक प्राप्तकर्ता जोडा."
          }
        },
