    "Gmail blocks this file type. A Google Drive link is required.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail bloque ce type de fichier. Un lien Google Drive est requis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blocks this file type. A Google Drive link is required."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail এই ফাইলের ধরনকে ব্লক করে। একটি লিঙ্ক Google Drive প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail bloqueja aquest tipus de fitxer. Cal un enllaç Google Drive."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokira ovu vrstu datoteke. Potrebna je veza Google Drive."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokuje tento typ souboru. Je vyžadován odkaz Google Drive."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokerer denne filtype. Et link Google Drive er påkrævet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokkeert dit bestandstype. Een link Google Drive is vereist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail estää tämän tiedostotyypin. Linkki Google Drive vaaditaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blockiert diesen Dateityp. Ein Link Google Drive ist erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Gmail αποκλείει αυτόν τον τύπο αρχείου. Απαιτείται σύνδεσμος Google Drive."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail આ ફાઇલ પ્રકારને અવરોધે છે. લિંક Google Drive જરૂરી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail חוסם את סוג הקובץ הזה. נדרש קישור Google Drive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail इस फ़ाइल प्रकार को ब्लॉक करता है। एक लिंक Google Drive आवश्यक है."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gmail blokkolja ezt a fájltípust. Egy link Google Drive szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail memblokir jenis file ini. Tautan Google Drive diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blocca questo tipo di file. È richiesto un collegamento Google Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail はこのファイル タイプをブロックします。リンクGoogle Driveが必要です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತದೆ. ಲಿಂಕ್ Google Drive ಅಗತ್ಯವಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail은(는) 이 파일 형식을 차단합니다. 링크 Google Drive이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail menyekat jenis fail ini. Pautan Google Drive diperlukan."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail ഈ ഫയൽ തരത്തെ തടയുന്നു. ഒരു ലിങ്ക് Google Drive ആവശ്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail हा फाइल प्रकार अवरोधित करते. लिंक Google Drive आवश्यक आहे."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokkerer denne filtypen. En lenke Google Drive er nødvendig."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail ଏହି ଫାଇଲ୍ ପ୍ରକାରକୁ ଅବରୋଧ କରେ | ଏକ ଲିଙ୍କ୍ Google Drive ଆବଶ୍ୟକ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail blokuje ten typ pliku. Wymagane jest łącze Google Drive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail bloqueia este tipo de arquivo. Um link Google Drive é necessário."
          }
