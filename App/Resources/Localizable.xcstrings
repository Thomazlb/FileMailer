        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મોડલ તૈયારીમાં છે. આ દરમિયાન FileMailer નિર્ણાયક ફોલબેકનો ઉપયોગ કરશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
