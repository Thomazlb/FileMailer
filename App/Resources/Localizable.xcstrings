        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail ଏହି ଫାଇଲ୍ ପ୍ରକାରକୁ ଅବରୋଧ କରେ | ପ୍ରଦତ୍ତ ଲିଙ୍କ୍ Google Drive ବ୍ୟବହାର କରନ୍ତୁ |"
