        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بطور ڈیفالٹ غیر فعال۔ منسلک فائلوں کو کبھی بھی مسودے میں کاپی نہیں کیا جاتا ہے۔"
