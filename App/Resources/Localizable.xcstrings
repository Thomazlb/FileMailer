    "Ajoutez les personnes que vous contactez le plus souvent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإضافة الأشخاص الذين تتصل بهم في أغلب الأحيان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি প্রায়ই যাদের সাথে যোগাযোগ করেন তাদের যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix les persones amb qui contacta més sovint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您最常联系的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增您最常聯繫的人。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte osobe s kojima najčešće kontaktirate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte lidi, které nejčastěji kontaktujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj de personer, du kontakter oftest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de mensen toe met wie u het vaakst contact opneemt."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the people you contact most often."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the people you contact most often."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the people you contact most often."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the people you contact most often."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ihmiset, joihin olet useimmin yhteydessä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les personnes que vous contactez le plus souvent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie die Personen hinzu, mit denen Sie am häufigsten Kontakt aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε τα άτομα με τα οποία επικοινωνείτε πιο συχνά."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે લોકોનો વારંવાર સંપર્ક કરો છો તેને ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף את האנשים שאתה יוצר איתם קשר בתדירות הגבוהה ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन लोगों को जोड़ें जिनसे आप सबसे अधिक बार संपर्क करते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá azokat az embereket, akikkel leggyakrabban lép kapcsolatba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan orang yang paling sering Anda hubungi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le persone che contatti più spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も頻繁に連絡する人を追加します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಹೆಚ್ಚಾಗಿ ಸಂಪರ್ಕಿಸುವ ಜನರನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 자주 연락하는 사람들을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan orang yang paling kerap anda hubungi."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ പതിവായി ബന്ധപ്പെടുന്ന ആളുകളെ ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ज्या लोकांशी वारंवार संपर्क साधता त्यांना जोडा."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til personene du kontakter oftest."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ପ୍ରାୟତ contact ଯୋଗାଯୋଗ କରୁଥିବା ଲୋକଙ୍କୁ ଯୋଡନ୍ତୁ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj osoby, z którymi najczęściej się kontaktujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as pessoas que você contata com mais frequência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as pessoas que você contata com mais frequência."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹਨਾਂ ਲੋਕਾਂ ਨੂੰ ਸ਼ਾਮਲ ਕਰੋ ਜਿਨ੍ਹਾਂ ਨਾਲ ਤੁਸੀਂ ਅਕਸਰ ਸੰਪਰਕ ਕਰਦੇ ਹੋ।"
          }
        },
        "ro": {
