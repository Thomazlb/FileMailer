    "Authorize Google Drive for this account before sending this link.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Google Drive pour ce compte avant d’envoyer ce lien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize Google Drive for this account before sending this link."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লিঙ্কটি পাঠানোর আগে এই অ্যাকাউন্টের জন্য Google Drive অনুমোদন করুন।"
