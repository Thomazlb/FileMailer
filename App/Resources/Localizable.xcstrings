    "Apple Intelligence is available in FileMailer from macOS 27. The deterministic draft remains available on macOS 26.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est disponible dans FileMailer à partir de macOS 27. Le brouillon déterministe reste disponible sur macOS 26."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is available in FileMailer from macOS 27. The deterministic draft remains available on macOS 26."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence متاح في FileMailer من macOS 27. وتظل المسودة الحتمية متاحة في macOS 26."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence macOS 27 থেকে FileMailer এ উপলব্ধ। নির্ধারক খসড়া macOS 26-এ উপলব্ধ রয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence està disponible a FileMailer a macOS 27. L'esborrany determinista continua disponible a macOS 26."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 在 macOS 27 的 FileMailer 中可用。确定性草案在 macOS 26 中仍然可用。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je dostupan u FileMailer od macOS 27. Deterministički nacrt ostaje dostupan u macOS 26."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
