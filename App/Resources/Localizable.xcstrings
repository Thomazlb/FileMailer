    "Disabled by default. Attached files are never copied to a draft.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Les fichiers joints ne sont jamais copiés dans un brouillon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled by default. Attached files are never copied to a draft."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিফল্টরূপে নিষ্ক্রিয়. সংযুক্ত ফাইলগুলি কখনই খসড়াতে অনুলিপি করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivat per defecte. Els fitxers adjunts mai es copien a un esborrany."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onemogućeno prema zadanim postavkama. Priložene datoteke nikada se ne kopiraju u skicu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím nastavení zakázáno. Přiložené soubory se nikdy nekopírují do konceptu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiveret som standard. Vedhæftede filer kopieres aldrig til en kladde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uitgeschakeld. Bijgevoegde bestanden worden nooit naar een concept gekopieerd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei käytössä oletuksena. Liitetiedostoja ei koskaan kopioida luonnokseen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig deaktiviert. Angehängte Dateien werden niemals in einen Entwurf kopiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιημένο από προεπιλογή. Τα συνημμένα αρχεία δεν αντιγράφονται ποτέ σε πρόχειρο."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિફૉલ્ટ રૂપે અક્ષમ. જોડાયેલ ફાઇલોને ક્યારેય ડ્રાફ્ટમાં કૉપિ કરવામાં આવતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושבת כברירת מחדל. קבצים מצורפים לעולם אינם מועתקים לטיוטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से अक्षम. संलग्न फ़ाइलें कभी भी ड्राफ्ट में कॉपी नहीं की जातीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés szerint letiltva. A csatolt fájlok soha nem másolódnak piszkozatba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinonaktifkan secara default. File terlampir tidak pernah disalin ke draf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabilitato per impostazione predefinita. I file allegati non vengono mai copiati in una bozza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは無効になっています。添付ファイルが下書きにコピーされることはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ಲಗತ್ತಿಸಲಾದ ಫೈಲ್‌ಗಳನ್ನು ಎಂದಿಗೂ ಡ್ರಾಫ್ಟ್‌ಗೆ ನಕಲಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 비활성화되어 있습니다. 첨부된 파일은 초안에 복사되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilumpuhkan secara lalai. Fail yang dilampirkan tidak pernah disalin ke draf."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിരസ്ഥിതിയായി പ്രവർത്തനരഹിതമാക്കി. അറ്റാച്ച് ചെയ്ത ഫയലുകൾ ഒരിക്കലും ഡ്രാഫ്റ്റിലേക്ക് പകർത്തില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डीफॉल्टनुसार अक्षम. संलग्न केलेल्या फाइल्स कधीही मसुद्यात कॉपी केल्या जात नाहीत."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivert som standard. Vedlagte filer blir aldri kopiert til et utkast."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡିଫଲ୍ଟ ଭାବରେ ଅକ୍ଷମ ହୋଇଛି | ସଂଲଗ୍ନିତ ଫାଇଲଗୁଡ଼ିକ କେବେବି ଏକ ଡ୍ରାଫ୍ଟରେ କପି କରାଯାଏ ନାହିଁ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wyłączone. Załączone pliki nigdy nie są kopiowane do wersji roboczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Os arquivos anexados nunca são copiados para um rascunho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por defeito. Os ficheiros anexados nunca são copiados para um rascunho."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੂਲ ਰੂਪ ਵਿੱਚ ਅਸਮਰੱਥ। ਅਟੈਚ ਕੀਤੀਆਂ ਫਾਈਲਾਂ ਨੂੰ ਕਦੇ ਵੀ ਡਰਾਫਟ ਵਿੱਚ ਕਾਪੀ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat implicit. Fișierele atașate nu sunt niciodată copiate într-o schiță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию отключено. Прикрепленные файлы никогда не копируются в черновик."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolene vypnuté. Priložené súbory sa nikdy neskopírujú do konceptu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privzeto onemogočeno. Priložene datoteke se nikoli ne kopirajo v osnutek."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshabilitado por defecto. Los archivos adjuntos nunca se copian en un borrador."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshabilitado por defecto. Los archivos adjuntos nunca se copian en un borrador."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaktiverad som standard. Bifogade filer kopieras aldrig till ett utkast."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயல்பாகவே முடக்கப்பட்டது. இணைக்கப்பட்ட கோப்புகள் ஒருபோதும் வரைவுக்கு நகலெடுக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిఫాల్ట్‌గా నిలిపివేయబడింది. జోడించిన ఫైల్‌లు ఎప్పుడూ డ్రాఫ్ట్‌కి కాపీ చేయబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้งานตามค่าเริ่มต้น ไฟล์ที่แนบมาจะไม่ถูกคัดลอกไปยังฉบับร่าง"
