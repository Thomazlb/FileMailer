    "In Finder, right-click a file, choose Send by Email, then choose a recipient.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Finder، انقر بزر الماوس الأيمن فوق الملف، واختر إرسال عبر البريد الإلكتروني، ثم اختر مستلمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইন্ডারে, একটি ফাইলে ডান-ক্লিক করুন, ইমেলের মাধ্যমে পাঠান নির্বাচন করুন, তারপর একজন প্রাপক চয়ন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al Finder, feu clic amb el botó dret a un fitxer, trieu Envia per correu electrònic i, a continuació, trieu un destinatari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中，右键单击文件，选择“通过电子邮件发送”，然后选择收件人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中，右鍵單擊文件，選擇“透過電子郵件發送”，然後選擇收件人。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U Finderu desnom tipkom miša kliknite datoteku, odaberite Pošalji e-poštom, zatim odaberite primatelja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Finderu klikněte pravým tlačítkem na soubor, vyberte Odeslat e-mailem a poté vyberte příjemce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I Finder skal du højreklikke på en fil, vælge Send via e-mail og derefter vælge en modtager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik in Finder met de rechtermuisknop op een bestand, kies Verzenden per e-mail en kies vervolgens een ontvanger."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, right-click a file, choose Send by Email, then choose a recipient."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, right-click a file, choose Send by Email, then choose a recipient."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, right-click a file, choose Send by Email, then choose a recipient."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, right-click a file, choose Send by Email, then choose a recipient."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta Finderissa tiedostoa hiiren kakkospainikkeella, valitse Lähetä sähköpostilla ja valitse sitten vastaanottaja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Finder, faites un clic droit sur un fichier, choisissez Envoyer par e-mail, puis un destinataire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie im Finder mit der rechten Maustaste auf eine Datei, wählen Sie „Per E-Mail senden“ und dann einen Empfänger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Finder, κάντε δεξί κλικ σε ένα αρχείο, επιλέξτε Αποστολή μέσω email και, στη συνέχεια, επιλέξτε έναν παραλήπτη."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇન્ડરમાં, ફાઇલ પર જમણું-ક્લિક કરો, ઇમેઇલ દ્વારા મોકલો પસંદ કરો, પછી પ્રાપ્તકર્તા પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-Finder, לחץ לחיצה ימנית על קובץ, בחר שלח בדוא\"ל ולאחר מכן בחר נמען."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइंडर में, फ़ाइल पर राइट-क्लिक करें, ईमेल द्वारा भेजें चुनें, फिर प्राप्तकर्ता चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finderben kattintson jobb gombbal egy fájlra, válassza a Küldés e-mailben lehetőséget, majd válassza ki a címzettet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Finder, klik kanan file, pilih Kirim melalui Email, lalu pilih penerima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel Finder, fai clic con il pulsante destro del mouse su un file, scegli Invia tramite email, quindi scegli un destinatario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder でファイルを右クリックし、[電子メールで送信] を選択して受信者を選択します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಂಡರ್‌ನಲ್ಲಿ, ಫೈಲ್ ಮೇಲೆ ಬಲ ಕ್ಲಿಕ್ ಮಾಡಿ, ಇಮೇಲ್ ಮೂಲಕ ಕಳುಹಿಸು ಆಯ್ಕೆಮಾಡಿ, ನಂತರ ಸ್ವೀಕರಿಸುವವರನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 파일을 마우스 오른쪽 버튼으로 클릭하고 이메일로 보내기를 선택한 다음 수신자를 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam Finder, klik kanan pada fail, pilih Hantar melalui E-mel, kemudian pilih penerima."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫൈൻഡറിൽ, ഒരു ഫയലിൽ വലത്-ക്ലിക്ക് ചെയ്യുക, ഇമെയിൽ വഴി അയയ്ക്കുക തിരഞ്ഞെടുക്കുക, തുടർന്ന് ഒരു സ്വീകർത്താവിനെ തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइंडरमध्ये, फाईलवर उजवे-क्लिक करा, ईमेलद्वारे पाठवा निवडा, नंतर प्राप्तकर्ता निवडा."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyreklikk en fil i Finder, velg Send via e-post, og velg deretter en mottaker."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫାଇଣ୍ଡରରେ, ଏକ ଫାଇଲ୍ ରାଇଟ୍ କ୍ଲିକ୍ କରନ୍ତୁ, ଇମେଲ୍ ଦ୍ୱାରା ପଠାନ୍ତୁ ବାଛନ୍ତୁ, ତାପରେ ଏକ ପ୍ରାପ୍ତକର୍ତ୍ତା ବାଛନ୍ତୁ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Finderze kliknij plik prawym przyciskiem myszy, wybierz opcję Wyślij e-mailem, a następnie wybierz odbiorcę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Finder, clique com o botão direito em um arquivo, escolha Enviar por e-mail e escolha um destinatário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No Finder, clique com o botão direito em um arquivo, escolha Enviar por e-mail e escolha um destinatário."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਂਡਰ ਵਿੱਚ, ਇੱਕ ਫਾਈਲ ਉੱਤੇ ਸੱਜਾ-ਕਲਿੱਕ ਕਰੋ, ਈਮੇਲ ਦੁਆਰਾ ਭੇਜੋ ਚੁਣੋ, ਫਿਰ ਇੱਕ ਪ੍ਰਾਪਤਕਰਤਾ ਚੁਣੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Finder, faceți clic dreapta pe un fișier, alegeți Trimitere prin e-mail, apoi alegeți un destinatar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Finder щелкните файл правой кнопкой мыши, выберите «Отправить по электронной почте», затем выберите получателя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vo Finderi kliknite pravým tlačidlom myši na súbor, vyberte Odoslať e-mailom a potom vyberte príjemcu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Finderju z desno miškino tipko kliknite datoteko, izberite Pošlji po e-pošti in nato izberite prejemnika."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En Finder, haga clic derecho en un archivo, elija Enviar por correo electrónico y luego elija un destinatario."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Finder, haga clic derecho en un archivo, elija Enviar por correo electrónico y luego elija un destinatario."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Finder, högerklicka på en fil, välj Skicka via e-post och välj sedan en mottagare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஃபைண்டரில், கோப்பில் வலது கிளிக் செய்து, மின்னஞ்சல் மூலம் அனுப்பு என்பதைத் தேர்வுசெய்து, பின்னர் பெறுநரைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైండర్‌లో, ఫైల్‌పై కుడి-క్లిక్ చేసి, ఇమెయిల్ ద్వారా పంపు ఎంచుకోండి, ఆపై గ్రహీతను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Finder ให้คลิกขวาที่ไฟล์ เลือก ส่งทางอีเมล จากนั้นเลือกผู้รับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder'da bir dosyaya sağ tıklayın, E-postayla Gönder'i seçin, ardından bir alıcı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Finder клацніть файл правою кнопкою миші, виберіть «Надіслати електронною поштою», а потім виберіть одержувача."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائنڈر میں، فائل پر دائیں کلک کریں، ای میل کے ذریعے بھیجیں کا انتخاب کریں، پھر وصول کنندہ کا انتخاب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Finder, bấm chuột phải vào tệp, chọn Gửi qua Email, sau đó chọn người nhận."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Finder, faites un clic droit sur un fichier, choisissez Envoyer par e-mail, puis un destinataire."
          }
        }
      }
    },
