          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence macOS 27 માંથી FileMailer માં ઉપલબ્ધ છે. નિર્ણાયક ડ્રાફ્ટ macOS 26 માં ઉપલબ્ધ રહે છે."
