        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಲಿಂಕ್ ಅನ್ನು ಕಳುಹಿಸುವ ಮೊದಲು ಈ ಖಾತೆಗೆ Google Drive ಅನ್ನು ದೃಢೀಕರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크를 보내기 전에 이 계정에 대해 Google Drive을(를) 승인하세요."
