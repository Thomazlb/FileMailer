    "The recipients, subjects, and bodies of these drafts will be deleted from this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les destinataires, objets et corps de ces brouillons seront supprimés de ce Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipients, subjects, and bodies of these drafts will be deleted from this Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ড্রাফ্টগুলির প্রাপক, বিষয় এবং সংস্থাগুলি এই ম্যাক থেকে মুছে ফেলা হবে৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els destinataris, els temes i els cossos d'aquests esborranys se suprimiran d'aquest Mac."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primatelji, subjekti i tijela ovih nacrta bit će izbrisani s ovog Maca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjemci, předměty a těla těchto konceptů budou z tohoto Macu odstraněni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modtagerne, emnerne og teksterne i disse udkast slettes fra denne Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ontvangers, onderwerpen en teksten van deze concepten worden van deze Mac verwijderd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden luonnosten vastaanottajat, aiheet ja tekstit poistetaan tästä Macista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Empfänger, Betreffzeilen und Texte dieser Entwürfe werden von diesem Mac gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παραλήπτες, τα θέματα και τα σώματα αυτών των πρόχειρων θα διαγραφούν από αυτό το Mac."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડ્રાફ્ટના પ્રાપ્તકર્તાઓ, વિષયો અને મુખ્ય ભાગોને આ Mac પરથી કાઢી નાખવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנמענים, הנושאים והגופים של טיוטות אלה יימחקו מ-Mac זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन ड्राफ्ट के प्राप्तकर्ता, विषय और निकाय इस मैक से हटा दिए जाएंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A piszkozatok címzettjei, tárgyai és törzsei törlődnek erről a Mac-ről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerima, subjek, dan isi draf ini akan dihapus dari Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I destinatari, i soggetti e i corpi di queste bozze verranno eliminati da questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの下書きの受信者、件名、本文はこの Mac から削除されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಡ್ರಾಫ್ಟ್‌ಗಳ ಸ್ವೀಕರಿಸುವವರು, ವಿಷಯಗಳು ಮತ್ತು ದೇಹಗಳನ್ನು ಈ Mac ನಿಂದ ಅಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초안의 수신자, 제목, 본문이 이 Mac에서 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerima, subjek dan badan draf ini akan dipadamkan daripada Mac ini."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഡ്രാഫ്റ്റുകളുടെ സ്വീകർത്താക്കളും വിഷയങ്ങളും ബോഡികളും ഈ Mac-ൽ നിന്ന് ഇല്ലാതാക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या मसुद्यांचे प्राप्तकर्ते, विषय आणि मुख्य भाग या Mac वरून हटवले जातील."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottakerne, emnene og tekstene til disse utkastene vil bli slettet fra denne Mac-en."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଡ୍ରାଫ୍ଟଗୁଡିକର ପ୍ରାପ୍ତକର୍ତ୍ତା, ବିଷୟ ଏବଂ ସଂସ୍ଥାଗୁଡ଼ିକ ଏହି ମ୍ୟାକ୍ ରୁ ବିଲୋପ ହେବ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbiorcy, tematy i treści tych wersji roboczych zostaną usunięte z tego komputera Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destinatários, assuntos e corpos desses rascunhos serão excluídos deste Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destinatários, assuntos e corpos destes rascunhos serão eliminados deste Mac."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹਨਾਂ ਡਰਾਫਟਾਂ ਦੇ ਪ੍ਰਾਪਤਕਰਤਾ, ਵਿਸ਼ਿਆਂ ਅਤੇ ਬਾਡੀਜ਼ ਨੂੰ ਇਸ ਮੈਕ ਤੋਂ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatarii, subiectele și corpurile acestor schițe vor fi șterse de pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получатели, темы и тексты этих черновиков будут удалены с этого Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príjemcovia, predmety a telá týchto konceptov budú z tohto Macu odstránené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejemniki, zadeve in telesa teh osnutkov bodo izbrisani iz tega računalnika Mac."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los destinatarios, asuntos y cuerpos de estos borradores se eliminarán de esta Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los destinatarios, asuntos y cuerpos de estos borradores se eliminarán de esta Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottagarna, ämnena och texterna i dessa utkast kommer att raderas från denna Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வரைவுகளின் பெறுநர்கள், பாடங்கள் மற்றும் உடல்கள் இந்த Mac இலிருந்து நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డ్రాఫ్ట్‌ల స్వీకర్తలు, సబ్జెక్ట్‌లు మరియు బాడీలు ఈ Mac నుండి తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้รับ หัวข้อ และเนื้อหาของฉบับร่างเหล่านี้จะถูกลบออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taslakların alıcıları, konuları ve gövdeleri bu Mac'ten silinecek."
