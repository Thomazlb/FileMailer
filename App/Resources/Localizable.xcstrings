    "Sending status is uncertain. Check the Sent folder in Gmail before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État d’envoi incertain. Vérifiez le dossier Envoyés dans Gmail avant de réessayer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending status is uncertain. Check the Sent folder in Gmail before trying again."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনিশ্চিত শিপিং অবস্থা. আবার চেষ্টা করার আগে Gmail-এ পাঠানো ফোল্ডারটি পরীক্ষা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estat d'enviament incert. Comproveu la carpeta Enviats a Gmail abans de tornar-ho a provar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesiguran status otpreme. Prije ponovnog pokušaja provjerite mapu Poslano u Gmail."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejistý stav zásilky. Než to zkusíte znovu, zkontrolujte složku Odeslané v Gmail."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Usikker forsendelsesstatus. Tjek mappen Sendt i Gmail, før du prøver igen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onzekere verzendstatus. Controleer de map Verzonden in Gmail voordat u het opnieuw probeert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Epävarma toimituksen tila. Tarkista Lähetetyt-kansio kohdassa Gmail, ennen kuin yrität uudelleen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicherer Versandstatus. Überprüfen Sie den Ordner „Gesendet“ in Gmail, bevor Sie es erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αβέβαιη κατάσταση αποστολής. Ελέγξτε το φάκελο Sent στο Gmail πριν προσπαθήσετε ξανά."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનિશ્ચિત શિપિંગ સ્થિતિ. ફરી પ્રયાસ કરતા પહેલા Gmail માં મોકલેલ ફોલ્ડર તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב משלוח לא בטוח. בדוק את התיקיה שנשלחה ב-Gmail לפני שתנסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनिश्चित शिपिंग स्थिति. दोबारा प्रयास करने से पहले Gmail में भेजे गए फ़ोल्डर की जाँच करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizonytalan szállítási állapot. Mielőtt újra próbálkozna, ellenőrizze az Elküldött mappát a Gmail alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status pengiriman tidak pasti. Periksa folder Terkirim di Gmail sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato della spedizione incerto. Controlla la cartella Inviati in Gmail prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送状況が不明。再試行する前に、Gmail の送信済みフォルダーを確認してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನಿಶ್ಚಿತ ಶಿಪ್ಪಿಂಗ್ ಸ್ಥಿತಿ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುವ ಮೊದಲು Gmail ನಲ್ಲಿ ಕಳುಹಿಸಿದ ಫೋಲ್ಡರ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송 상태가 불확실합니다. 다시 시도하기 전에 Gmail의 보낸 폴더를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Status penghantaran tidak menentu. Semak folder Dihantar dalam Gmail sebelum mencuba lagi."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അനിശ്ചിതത്വമുള്ള ഷിപ്പിംഗ് നില. വീണ്ടും ശ്രമിക്കുന്നതിന് മുമ്പ് Gmail എന്നതിലെ അയച്ച ഫോൾഡർ പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनिश्चित शिपिंग स्थिती. पुन्हा प्रयत्न करण्यापूर्वी Gmail मध्ये पाठवलेले फोल्डर तपासा."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Usikker fraktstatus. Sjekk Sendt-mappen i Gmail før du prøver igjen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନିଶ୍ଚିତ ପରିବହନ ସ୍ଥିତି | ପୁନର୍ବାର ଚେଷ୍ଟା କରିବା ପୂର୍ବରୁ Gmail ରେ ପଠାଯାଇଥିବା ଫୋଲ୍ଡରକୁ ଯାଞ୍ଚ କରନ୍ତୁ |"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niepewny status wysyłki. Zanim spróbujesz ponownie, sprawdź folder Wysłane w Gmail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Status de envio incerto. Verifique a pasta Enviados em Gmail antes de tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de envio incerto. Verifique a pasta Enviados em Gmail antes de tentar novamente."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਨਿਸ਼ਚਿਤ ਸ਼ਿਪਿੰਗ ਸਥਿਤੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ Gmail ਵਿੱਚ ਭੇਜੇ ਫੋਲਡਰ ਦੀ ਜਾਂਚ ਕਰੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stare de expediere incertă. Verificați folderul Trimis din Gmail înainte de a încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неопределенный статус доставки. Прежде чем повторить попытку, проверьте папку «Отправленные» в Gmail."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neistý stav zásielky. Pred opätovným pokusom skontrolujte priečinok Odoslané v Gmail."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Negotovo stanje pošiljanja. Preverite mapo Poslano v Gmail, preden poskusite znova."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de envío incierto. Verifique la carpeta Enviados en Gmail antes de volver a intentarlo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de envío incierto. Verifique la carpeta Enviados en Gmail antes de volver a intentarlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Osäker fraktstatus. Kontrollera mappen Skickat i Gmail innan du försöker igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிச்சயமற்ற கப்பல் நிலை. மீண்டும் முயற்சிக்கும் முன் Gmail இல் உள்ள அனுப்பிய கோப்புறையைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనిశ్చిత షిప్పింగ్ స్థితి. మళ్లీ ప్రయత్నించే ముందు Gmailలోని పంపిన ఫోల్డర్‌ను తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะการจัดส่งไม่แน่นอน ตรวจสอบโฟลเดอร์ส่งแล้วใน Gmail ก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirsiz gönderim durumu. Tekrar denemeden önce Gmail'daki Gönderilenler klasörünü kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невизначений статус доставки. Перш ніж повторити спробу, перевірте папку «Надіслані» в Gmail."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غیر یقینی شپنگ کی حیثیت۔ دوبارہ کوشش کرنے سے پہلے Gmail میں بھیجے گئے فولڈر کو چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tình trạng vận chuyển không chắc chắn. Hãy kiểm tra thư mục Đã gửi trong Gmail trước khi thử lại."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending status is uncertain. Check the Sent folder in Gmail before trying again."
          }
