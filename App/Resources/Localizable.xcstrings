        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξουσιοδοτήστε το Google Drive για αυτόν τον λογαριασμό πριν στείλετε αυτόν τον σύνδεσμο."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લિંક મોકલતા પહેલા આ એકાઉન્ટ માટે Google Drive ને અધિકૃત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר את Google Drive לחשבון זה לפני שליחת הקישור הזה."
