          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल तैयार किया जा रहा है. FileMailer इस बीच नियतात्मक फ़ॉलबैक का उपयोग करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model je u pripremi. FileMailer će u međuvremenu koristiti determinističku zamjenu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell előkészítés alatt áll. A FileMailer időközben determinisztikus tartalékot fog használni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelnya sedang dalam persiapan. FileMailer akan menggunakan fallback deterministik untuk sementara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è in preparazione. Nel frattempo FileMailer utilizzerà il fallback deterministico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは準備中です。 FileMailer はそれまでの間、決定論的フォールバックを使用します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾದರಿ ತಯಾರಿಯಲ್ಲಿದೆ. FileMailer ಈ ಮಧ್ಯೆ ನಿರ್ಣಾಯಕ ಫಾಲ್ಬ್ಯಾಕ್ ಅನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 준비중입니다. FileMailer은 그 동안 결정론적 대체를 사용합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാതൃക ഒരുക്കത്തിലാണ്. FileMailer അതിനിടയിൽ ഡിറ്റർമിനിസ്റ്റിക് ഫാൾബാക്ക് ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडेलची तयारी सुरू आहे. FileMailer यादरम्यान निर्धारक फॉलबॅक वापरेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sedang dalam persiapan. FileMailer akan menggunakan sandaran deterministik sementara itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model is in voorbereiding. FileMailer maakt in de tussentijd gebruik van deterministische fallback."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen er under utarbeidelse. FileMailer vil bruke deterministisk fallback i mellomtiden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମଡେଲ୍ ପ୍ରସ୍ତୁତିରେ ଅଛି | FileMailer ମ in ିରେ ମ determ ିରେ ସ୍ଥିରିକୃତ ଫଲବ୍ୟାକ୍ ବ୍ୟବହାର କରିବ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਡਲ ਦੀ ਤਿਆਰੀ ਚੱਲ ਰਹੀ ਹੈ। FileMailer ਇਸ ਦੌਰਾਨ ਨਿਰਣਾਇਕ ਫਾਲਬੈਕ ਦੀ ਵਰਤੋਂ ਕਰੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model jest w przygotowaniu. W międzyczasie FileMailer użyje deterministycznego powrotu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está em preparação. Enquanto isso, FileMailer usará substituto determinístico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está em preparação. Enquanto isso, FileMailer utilizará substituto determinístico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul este în pregătire. FileMailer va folosi între timp backback determinist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель находится в стадии подготовки. Тем временем FileMailer будет использовать детерминированный резервный вариант."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model je v príprave. FileMailer medzitým použije deterministický núdzový režim."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model je v pripravi. FileMailer bo medtem uporabljal deterministično nadomestno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen är under förberedelse. FileMailer kommer att använda deterministisk reserv under tiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாடல் தயார் நிலையில் உள்ளது. FileMailer இதற்கிடையில் உறுதியான பின்னடைவைப் பயன்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడల్ తయారీలో ఉంది. FileMailer ఈ సమయంలో నిర్ణయాత్మక ఫాల్‌బ్యాక్‌ని ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลอยู่ในระหว่างการเตรียมการ FileMailer จะใช้ทางเลือกสำรองตามที่กำหนดในระหว่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hazırlık aşamasındadır. FileMailer bu arada deterministik geri dönüşü kullanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель знаходиться в підготовці. Тим часом FileMailer використовуватиме детермінований резерв."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل تیاری میں ہے۔ FileMailer اس دوران تعییناتی فال بیک استعمال کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình đang được chuẩn bị. FileMailer sẽ sử dụng dự phòng xác định trong thời gian chờ đợi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该模型正在准备中。 FileMailer 同时将使用确定性回退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該模型正在準備中。 FileMailer 同時將使用確定性回退。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est en préparation. FileMailer utilisera le fallback déterministe entre-temps."
          }
        }
      }
