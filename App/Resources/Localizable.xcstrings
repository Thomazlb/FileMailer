    "macOS requires manual activation. FileMailer does not inject code into Finder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS يتطلب التنشيط اليدوي. لا يقوم FileMailer بإدخال أي كود في Finder."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ম্যানুয়াল অ্যাক্টিভেশন প্রয়োজন। FileMailer Finder-এ কোনো কোড ইনজেক্ট করে না।"
          }
        },
