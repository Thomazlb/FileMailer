        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder থেকে প্রতিটি চালান প্রস্তুত এবং প্রুফরিড করার জন্য একটি ওপেন সোর্স macOS অ্যাপ্লিকেশন।"
          }
        },
        "ca": {
