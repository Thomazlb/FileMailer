    "Google Drive does not allow this file to be made accessible by link.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive ne permet pas de rendre ce fichier accessible par lien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive does not allow this file to be made accessible by link."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive এই ফাইলটিকে লিঙ্কের মাধ্যমে অ্যাক্সেসযোগ্য করার অনুমতি দেয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive no permet que aquest fitxer sigui accessible mitjançant un enllaç."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive ne dopušta da ova datoteka bude dostupna putem veze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive neumožňuje zpřístupnění tohoto souboru pomocí odkazu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive tillader ikke, at denne fil gøres tilgængelig via et link."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive staat niet toe dat dit bestand via een link toegankelijk wordt gemaakt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive ei salli tämän tiedoston saattamista käytettäväksi linkin kautta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive erlaubt nicht, dass diese Datei per Link zugänglich gemacht wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Google Drive δεν επιτρέπει σε αυτό το αρχείο να είναι προσβάσιμο μέσω συνδέσμου."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive આ ફાઇલને લિંક દ્વારા ઍક્સેસિબલ બનાવવાની મંજૂરી આપતું નથી."
