        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലിങ്ക് അയയ്‌ക്കുന്നതിന് മുമ്പ് ഈ അക്കൗണ്ടിനായി Google Drive അംഗീകരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही लिंक पाठवण्यापूर्वी या खात्यासाठी Google Drive अधिकृत करा."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser Google Drive for denne kontoen før du sender denne koblingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଲିଙ୍କ୍ ପଠାଇବା ପୂର୍ବରୁ ଏହି ଖାତା ପାଇଁ Google Drive ପ୍ରାଧିକରଣ କରନ୍ତୁ |"
