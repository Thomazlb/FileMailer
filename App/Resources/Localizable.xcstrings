    "Le brouillon déterministe et la rédaction manuelle restent disponibles.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الصياغة الحتمية والكتابة اليدوية متاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিটারমিনিস্টিক ড্রাফটিং এবং ম্যানুয়াল লেখা উপলব্ধ রয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La redacció determinista i l'escriptura manual continuen disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定性起草和手动编写仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定性起草和手動編寫仍然可用。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaje dostupna deterministička izrada i ručno pisanje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministické kreslení a ruční psaní zůstávají k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministisk udkast og manuel skrivning forbliver tilgængelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministisch opstellen en handmatig schrijven blijven beschikbaar."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministic drafting and manual writing remain available."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministic drafting and manual writing remain available."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministic drafting and manual writing remain available."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministic drafting and manual writing remain available."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministinen luonnos ja manuaalinen kirjoittaminen ovat edelleen käytettävissä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon déterministe et la rédaction manuelle restent disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministisches Zeichnen und manuelles Schreiben bleiben weiterhin verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ντετερμινιστική σύνταξη και η χειροκίνητη γραφή παραμένουν διαθέσιμα."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિર્ધારિત મુસદ્દો અને મેન્યુઅલ લેખન ઉપલબ્ધ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרטוט דטרמיניסטי וכתיבה ידנית נשארים זמינים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियतात्मक प्रारूपण और मैन्युअल लेखन उपलब्ध रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A determinisztikus szerkesztés és a kézi írás továbbra is elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyusunan deterministik dan penulisan manual tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano disponibili la redazione deterministica e la scrittura manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定的な製図と手動による作成は引き続き利用できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡಿಟರ್ಮಿನಿಸ್ಟಿಕ್ ಡ್ರಾಫ್ಟಿಂಗ್ ಮತ್ತು ಹಸ್ತಚಾಲಿತ ಬರವಣಿಗೆಗಳು ಲಭ್ಯವಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
