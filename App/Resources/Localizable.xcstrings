        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizirajte Google Drive za ovaj račun prije slanja ove veze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před odesláním tohoto odkazu autorizujte Google Drive pro tento účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkend Google Drive til denne konto, før du sender dette link."
